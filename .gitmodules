[submodule "ext/fmt"]
	path = ext/fmt
	url = https://github.com/fmtlib/fmt.git
[submodule "ext/SDL"]
	path = ext/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "ext/json"]
	path = ext/json
	url = https://github.com/nlohmann/json.git
[submodule "ext/SDL_image"]
	path = ext/SDL_image
	url = https://github.com/libsdl-org/SDL_image.git
[submodule "ext/glm"]
	path = ext/glm
	url = https://github.com/g-truc/glm.git
[submodule "ext/imgui"]
	path = ext/imgui
	url = https://github.com/ocornut/imgui.git
[submodule "ext/cmrc"]
	path = ext/cmrc
	url = https://github.com/vector-of-bool/cmrc.git
[submodule "ext/tileson"]
	path = ext/tileson
	url = https://github.com/SSBMTonberry/tileson.git
[submodule "ext/freetype"]
	path = ext/freetype
	url = https://github.com/freetype/freetype.git
[submodule "ext/RmlUi"]
	path = ext/RmlUi
	url = https://github.com/mikke89/RmlUi.git
