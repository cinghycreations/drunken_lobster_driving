{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-dev",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}"
        },
        {
            "name": "windows-release",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "cacheVariables": {
                "CC_HAS_DEVUI": "OFF",
                "CC_HAS_EMBED_CONTENT": "ON"
            }
        },
        {
            "name": "linux-dev",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}"
        },
        {
            "name": "linux-release",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "cacheVariables": {
                "CC_HAS_DEVUI": "OFF",
                "CC_HAS_EMBED_CONTENT": "ON"
            }
        },
        {
            "name": "emscripten-dev",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "toolchainFile": "$env{EMSDK_HOME}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CC_HAS_EMBED_CONTENT": "ON",
                "CMAKE_EXE_LINKER_FLAGS": "--shell-file $env{EMSDK_HOME}/upstream/emscripten/src/shell_minimal.html",
                "CMAKE_EXECUTABLE_SUFFIX_CXX": ".html"
            }
        },
        {
            "name": "emscripten-release",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
