{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-dev",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}"
        },
        {
            "name": "windows-release",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "cacheVariables": {
                "CC_HAS_DEVUI": "OFF"
            }
        },
        {
            "name": "linux-dev",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}"
        },
        {
            "name": "linux-release",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "cacheVariables": {
                "CC_HAS_DEVUI": "OFF"
            }
        },
        {
            "name": "html5-dev",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "toolchainFile": "$env{EMSDK_HOME}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CC_HAS_BUILDER" : "OFF",
                "CMAKE_EXE_LINKER_FLAGS": "-sALLOW_MEMORY_GROWTH --embed-file ${sourceDir}/content/emscripten/@/ --shell-file ${sourceDir}/etc/shell.html"
            }
        },
        {
            "name": "html5-release",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "toolchainFile": "$env{EMSDK_HOME}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CC_HAS_BUILDER" : "OFF",
                "CC_HAS_DEVUI": "OFF",
                "CMAKE_EXE_LINKER_FLAGS": "-sALLOW_MEMORY_GROWTH --embed-file ${sourceDir}/content/emscripten/@/ --shell-file ${sourceDir}/etc/shell.html"
            }
        },
        {
            "name": "android-dev",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a"
            }
        },
        {
            "name": "android-release",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "CC_HAS_DEVUI": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-dev",
            "configurePreset": "windows-dev",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "configuration": "Release"
        },
        {
            "name": "linux-dev",
            "configurePreset": "linux-dev",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "configuration": "Release"
        },
        {
            "name": "html5-dev",
            "configurePreset": "html5-dev",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "html5-release",
            "configurePreset": "html5-release",
            "configuration": "Release"
        },
        {
            "name": "android-dev",
            "configurePreset": "android-dev",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "android-release",
            "configurePreset": "android-release",
            "configuration": "Release"
        }
    ]
}