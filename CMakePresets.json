                "CC_HAS_DEVUI": "OFF",
                "CC_HAS_EMBED_CONTENT": "ON",
                "CMAKE_EXE_LINKER_FLAGS": "--shell-file $env{EMSDK_HOME}/upstream/emscripten/src/shell_minimal.html",
                "CMAKE_EXECUTABLE_SUFFIX_CXX": ".html"
            }
        },
        {
            "name": "android-dev",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
            "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "CC_HAS_EMBED_CONTENT": "ON",
                "CC_HAS_EXECUTABLE_AS_LIBRARY": "ON"
            }
        },
        {
            "name": "android-release",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/temp/build/${presetName}",
            "installDir": "${sourceDir}/temp/install/${presetName}",
